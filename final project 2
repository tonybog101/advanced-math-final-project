%% =========================================================
%  FUNCTIONS
%% =========================================================

function [wh, wo, bh, bo] = init_weights(NI, NH, NO)
% INIT_WEIGHTS  Initialize network parameters.
%
%   Uses a uniform distribution in [-0.5, 0.5] so that all values
%   have moderate magnitude and include both positive and negative
%   numbers — avoiding symmetry breaking issues.
%
%   wh : [NH x NI]   hidden-layer weights
%   wo : [NO x NH]   output-layer weights
%   bh : [NH x  1]   hidden-layer biases
%   bo : [NO x  1]   output-layer biases

    wh = rand(NH, NI) - 0.5;
    wo = rand(NO, NH) - 0.5;
    bh = rand(NH,  1) - 0.5;
    bo = rand(NO,  1) - 0.5;
end


function [y_hat, H] = forward_pass(X, wh, bh, wo, bo)
% FORWARD_PASS  Two-layer feedforward propagation.
%
%   Hidden layer  (sigmoid activation):
%     S_h   = X * wh' + bh'        [NB x NH]
%     H     = sigmoid(S_h)          [NB x NH]
%
%   Output layer  (softmax activation):
%     S_o   = H * wo' + bo'         [NB x NO]
%     y_hat = softmax(S_o)           [NB x NO]
%
%   Dimensions:
%     X     : [NB x NI]
%     wh    : [NH x NI] => wh'  : [NI x NH]
%     bh    : [NH x  1] => bh'  : [ 1 x NH]  (broadcast)
%     wo    : [NO x NH] => wo'  : [NH x NO]
%     bo    : [NO x  1] => bo'  : [ 1 x NO]  (broadcast)

    % Hidden layer: linear transform + sigmoid
    S_h   = X * wh' + bh';     % [NB x NH]
    H     = sigmaa(S_h);       % [NB x NH]

    % Output layer: linear transform + softmax
    S_o   = H * wo' + bo';     % [NB x NO]
    y_hat = softmax(S_o);      % [NB x NO]
end


function [g_wh, g_bh, g_wo, g_bo] = backprop(X, y_hat, T, H, wo, BZ)
% BACKPROP  Compute gradients via backpropagation.
%
%   Output-layer error:
%     Delta = (y_hat - T) / BZ              [NB x NO]
%
%   Hidden-layer error (chain rule through sigmoid):
%     delta = (Delta * wo) .* H .* (1 - H)  [NB x NH]
%
%   Gradients:
%     dE/dwo = Delta' * H                   [NO x NH]
%     dE/dbo = sum(Delta', 2)               [NO x  1]
%     dE/dwh = delta' * X                   [NH x NI]
%     dE/dbh = sum(delta', 2)               [NH x  1]

    % Output layer error
    Delta = (y_hat - T) ./ BZ;              % [NB x NO]

    % Hidden layer error (backprop through sigmoid)
    delta = (Delta * wo) .* H .* (1 - H);  % [NB x NH]

    % Output layer gradients
    g_wo = Delta' * H;                      % [NO x NH]
    g_bo = sum(Delta', 2);                  % [NO x  1]

    % Hidden layer gradients
    g_wh = delta' * X;                      % [NH x NI]
    g_bh = sum(delta', 2);                  % [NH x  1]
end


% ---- Utility functions (do not modify) ----

function z = sigmaa(s)
% Sigmoid activation function
    z = 1 ./ (1 + exp(-s));
end

function ss = softmax(z)
% Numerically stable softmax (subtract row max before exp)
    z  = z - max(z, [], 2);        % subtract row-wise max for stability
    ES = sum(exp(z), 2);
    ss = exp(z) ./ ES;
end

function oh = one_hot(y, P)
% ONE_HOT  Convert label vector to one-hot matrix.
    N  = length(y);
    oh = zeros(N, P);
    for i = 1:N
        oh(i, y(i) + 1) = 1;
    end
end

function P = inv_oneHot(y)
% INV_ONEHOT  Convert one-hot (or probability) matrix to class labels.
    [~, P] = max(y, [], 2);
    P = P - 1;          % shift back to 0-based labels
end
