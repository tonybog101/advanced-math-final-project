%% Initialize

close all;
clear all;
clc;

addpath(genpath(pwd))

%% Load dataset

% Replace with your directory path and file name
data_dir = 'C:\Users\gateway\Downloads';

% Training Data
fname_train = 'mnist_train.csv';

M = readmatrix(fullfile(data_dir, fname_train));
X = M(:, 2:end);
Y = M(:, 1);
N = length(Y);

% Testing Data
fname_test = 'mnist_test.csv';

M_test = readmatrix(fullfile(data_dir, fname_test));
X_test = M_test(:,2:end);
Y_test = M_test(:,1);
N_test = length(Y_test);

% Normalize data
X = X./255;
X_test = X_test./255;


%% Display dataset

% Display Training data samples

rand_disp = randperm(N, 20);

    figure(10)

    for si = 1:20
        subplot(4,5,si)
        imagesc(reshape(X(rand_disp(si),:),28,28)')
        title(['Digit: ',num2str(Y(rand_disp(si)))])
        colormap gray
        axis('square')
        xticks([])
        yticks([])
    end
drawnow;


%% Specify number of hidden units and initialize weights

Ni = size(X, 2);   % Number of input features  (784: one per pixel)
No = 10;           % Number of output classes   (digits 0–9)
Nh = 128;          % Number of hidden layer nodes

% Weight / bias dimensions
%   wh : [Nh x Ni]   hidden-layer weight matrix
%   wo : [No x Nh]   output-layer weight matrix
%   bh : [Nh x  1]   hidden-layer bias vector
%   bo : [No x  1]   output-layer bias vector

[wh, wo, bh, bo] = init_weights(Ni, Nh, No);


%% Neural Network Training
% Run this section (or the whole script) multiple times to keep training.

BZ         = 32;    % Mini-batch size
EPH        = 30;    % Number of epochs
lr         = 0.05;  % Learning rate
save_every = 5;     % Save a checkpoint every N epochs

NB  = floor(N / BZ);
Err = NaN .* zeros(EPH * NB, 2);   % col 1 = error, col 2 = accuracy

cnt = 1;
for ep = 1:EPH

    % Shuffle training set each epoch
    i_rand = randperm(N);
    XX  = X(i_rand, :);
    YYY = Y(i_rand);

    for bz = 1:NB
        ss = (bz - 1) * BZ + 1;
        ee =  bz      * BZ;

        % One-hot encode the current mini-batch targets
        T = one_hot(YYY(ss:ee), No);       % [BZ x No]

        % ---- Forward propagation ----
        [y_hat, H] = forward_pass(XX(ss:ee, :), wh, bh, wo, bo);

        % Batch error (Euclidean distance) and accuracy
        Err(cnt, 1) = sum(sqrt(sum((T - y_hat).^2, 2))) ./ BZ;
        Err(cnt, 2) = sum(inv_oneHot(T) == inv_oneHot(y_hat)) ./ BZ;

        % ---- Backpropagation ----
        [g_wh, g_bh, g_wo, g_bo] = backprop(XX(ss:ee, :), y_hat, T, H, wo, BZ);

        % ---- Gradient descent update ----
        wh = wh - lr .* g_wh;
        wo = wo - lr .* g_wo;
        bh = bh - lr .* g_bh;
        bo = bo - lr .* g_bo;

        cnt = cnt + 1;
    end

    % Live training plot (update each epoch)
    figure(1)
    yyaxis left
    plot(Err(:, 2), 'b-')
    ylabel('Accuracy')
    ylim([0 1])
    yyaxis right
    plot(Err(:, 1), 'r-')
    ylabel('Error')
    xlabel('Iteration')
    title(['Training — Epoch ', num2str(ep), ' / ', num2str(EPH)])
    legend({'Accuracy', 'Error'}, 'Location', 'best')
    drawnow;

    % ---- Periodic checkpoint save ----
    if mod(ep, save_every) == 0
        fname_ckpt = ['model_epoch', num2str(ep), '.mat'];
        save(fname_ckpt, 'wh', 'wo', 'bh', 'bo');
        fprintf('Checkpoint saved: %s\n', fname_ckpt);
    end

end

